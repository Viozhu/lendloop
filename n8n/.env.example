# n8n stack configuration, read by `docker compose` (see docker-compose.yml).
# Copy to n8n/.env and fill in. n8n/.env is git-ignored.
#
# Generate secrets with: openssl rand -hex 32

# Encrypts credentials stored in n8n's database. Keep it stable: changing it
# makes existing credentials unreadable.
N8N_ENCRYPTION_KEY=

# Where n8n reaches Convex HTTP actions. Default: the Convex local deployment
# on the host. With a cloud deployment use https://<deployment>.convex.site
CONVEX_HTTP_URL=http://host.docker.internal:3211

# Must equal the Convex env var of the same name (npx convex env set ...).
# Convex signs loan events with it; the webhook workflow verifies.
CONVEX_TO_N8N_SECRET=
# n8n signs calls to Convex /n8n/* endpoints with it; Convex verifies.
N8N_TO_CONVEX_SECRET=

# Receives error-workflow alerts (caught by Mailpit locally).
ADMIN_ALERT_EMAIL=admin@lendloop.local
# Used for links inside emails.
APP_BASE_URL=http://localhost:3000
# Time zone for the 09:00 overdue reminder schedule.
GENERIC_TIMEZONE=UTC

# Postgres for n8n's own data (workflows, executions, credentials).
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
