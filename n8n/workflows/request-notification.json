    {
      "parameters": {
        "jsCode": "// Record the event as sent and forget entries older than a week (Convex stops\n// retrying after ~13 minutes, so a week is a generous window).\nconst WEEK_MS = 7 * 24 * 60 * 60 * 1000;\nconst staticData = $getWorkflowStaticData('global');\nconst sent = staticData.sentEventIds ?? {};\nconst now = Date.now();\nfor (const [id, at] of Object.entries(sent)) {\n  if (now - at > WEEK_MS) delete sent[id];\n}\nconst { eventId, type } = $('Check duplicate').first().json.event;\nsent[eventId] = now;\nstaticData.sentEventIds = sent;\nreturn [{ json: { eventId, type } }];\n"
      },
