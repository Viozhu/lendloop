      "parameters": {
        "jsCode": "// Verifies X-LendLoop-Signature against the *raw* body (Webhook \"Raw Body\" option):\n// sha256=HMAC_SHA256(CONVEX_TO_N8N_SECRET, `${timestamp}.${rawBody}`), constant-time\n// compare, and a 300 s window against replays.\nconst crypto = require('crypto');\nconst MAX_SKEW_SECONDS = 300;\n\nconst headers = $input.first().json.headers ?? {};\nconst timestamp = String(headers['x-lendloop-timestamp'] ?? '');\nconst signature = String(headers['x-lendloop-signature'] ?? '').trim().toLowerCase();\nconst secret = $env.CONVEX_TO_N8N_SECRET;\n\nlet rawBody = '';\ntry {\n  rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch {\n  // No body at all: verification below fails.\n}\n\nfunction failureReason() {\n  if (!secret) return 'not_configured';\n  if (!/^\\d{1,12}$/.test(timestamp) || !signature) return 'missing_headers';\n  if (Math.abs(Date.now() / 1000 - Number(timestamp)) > MAX_SKEW_SECONDS) return 'stale_timestamp';\n  const expected = Buffer.from(\n    'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex'),\n  );\n  const given = Buffer.from(signature);\n  return expected.length === given.length && crypto.timingSafeEqual(expected, given) ? null : 'bad_signature';\n}\n\nconst reason = failureReason();\nif (reason) return [{ json: { valid: false, reason } }];\nreturn [{ json: { valid: true, event: JSON.parse(rawBody) } }];\n"
      },
