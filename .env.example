# ---------------------------------------------------------------------------
# Next.js (.env.local). `npx convex dev` writes the CONVEX_* values for you.
# ---------------------------------------------------------------------------

# Which Convex deployment `npx convex dev` targets (written by the CLI).
CONVEX_DEPLOYMENT=
# Convex client URL. Local deployment default: http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP actions URL. Local deployment default: http://127.0.0.1:3211
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk Dashboard > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Convex deployment env. Set with `npx convex env set NAME value`, NOT here:
# Convex functions cannot read .env.local.
# ---------------------------------------------------------------------------
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL (Clerk Dashboard > Integrations > Convex)
# N8N_NOTIFY_WEBHOOK_URL    n8n production webhook for loan events,
#                           e.g. http://localhost:5678/webhook/lendloop-loan-events
# CONVEX_TO_N8N_SECRET      Convex signs outgoing webhooks with it; n8n verifies.
#                           Must match CONVEX_TO_N8N_SECRET in n8n/.env.
# N8N_TO_CONVEX_SECRET      n8n signs calls to /n8n/* with it; Convex verifies.
#                           Must match N8N_TO_CONVEX_SECRET in n8n/.env.
# APP_BASE_URL              Public URL of the web app, used for links in emails,
#                           e.g. http://localhost:3000
#
# Generate each secret with: openssl rand -hex 32
