{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "stack:up": "docker compose --env-file n8n/.env up -d",
    "stack:down": "docker compose --env-file n8n/.env down",
    "n8n:import": "scripts/n8n.sh import",
    "n8n:export": "scripts/n8n.sh export",
    "n8n:credentials": "scripts/n8n.sh credentials",
    "check-secrets": "scripts/check-secrets.sh",
    "n8n:smoke": "node scripts/n8n-smoke.mjs",
    "n8n:remind": "docker compose --env-file n8n/.env exec -T -e N8N_RUNNERS_BROKER_PORT=5681 n8n n8n execute --id=LLoverdueRemind1",
    "seed": "convex run seed:run",
    "setup:local": "scripts/setup-local.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.23",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "convex": "^1.49.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.66",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.13"
  }
}
